# Copy to .env and fill in. Never commit .env.
# Local dev needs nothing below; Stage 5 fills these in.

SWIMTECH_DATA_DIR=data
SWIMTECH_CORS_ORIGINS=http://localhost:5173

# Stage 5.3 Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=swimtech-races

# Stage 5.4 Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Stage 5.2 Modal (set via `modal token new`, not here)

# Stage 5.5 Sentry
SENTRY_DSN=

# Stage 7.4 plain-language findings
ANTHROPIC_API_KEY=
